---
import "../styles/global.css";
import { translations } from "../lib/i18n.ts";

const meta = translations.en.meta;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#05050f" />
    <link rel="icon" href="/brand/am-hexagon-mark.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/brand/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon-180.png" type="image/png" sizes="180x180" />
    <title>{meta.title}</title>
    <script is:inline>
      try {
        const locale = document.cookie.match(/(?:^|;\s*)lang=(id|en)(?:;|$)/)?.[1];
        if (locale === "id") {
          document.documentElement.lang = "id";
          document.documentElement.dataset.localePending = "true";
        }
        if (localStorage.getItem("theme") === "light") {
          document.documentElement.dataset.theme = "light";
        }
      } catch {
        // The page remains usable with the default locale and dark theme.
      }
    </script>
    <noscript><style>[data-reveal] { opacity: 1; transform: none; }</style></noscript>
  </head>
  <body class="antialiased">
    <slot />
    <script src="../scripts/portfolio.ts"></script>
  </body>
</html>
