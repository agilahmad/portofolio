---
import { NAV_LINKS } from "../lib/data.ts";
import { translations } from "../lib/i18n.ts";

const resumeLabel = translations.en.nav.resume;
const themeToggleClass =
  "inline-flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full border border-border bg-transparent text-muted transition-[color,border-color,background-color,box-shadow,transform] duration-200 ease-out hover:border-border-bright hover:bg-white/5 hover:text-fg active:scale-95";
const langToggleClass =
  "inline-flex min-h-11 shrink-0 cursor-pointer items-center justify-center gap-1.5 rounded-full border border-border bg-transparent px-3 text-xs font-semibold text-muted transition-[color,border-color,background-color,box-shadow,transform] duration-200 ease-out hover:border-border-bright hover:bg-white/5 hover:text-fg active:scale-95";
---

<nav
  class="fixed top-0 z-[100] w-full border-b border-border bg-[rgba(var(--bg-rgb),0.94)] backdrop-blur-[14px]"
  aria-label={translations.en.nav.primaryLabel}
  data-i18n-aria="nav.primaryLabel"
>
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-6 px-4 sm:px-6">
    <a
      href="#"
      data-scroll-target="top"
      data-i18n-aria="nav.backToTop"
      class="flex items-center gap-[.7rem] no-underline"
      aria-label={translations.en.nav.backToTop}
    >
      <span class="dot" aria-hidden="true"></span>
      <span class="text-[.7rem] tracking-[.22em] text-fg uppercase">
        AGIL AHMAD MAULANA
      </span>
    </a>

    <div class="nav-desktop">
      {NAV_LINKS.map((section) => (
        <a
          href={`#${section}`}
          data-scroll-target={section}
          data-i18n={`nav.links.${section}`}
          class="nav-link flex min-h-11 items-center rounded-full px-3 text-sm font-semibold tracking-normal hover:bg-white/5"
        >{translations.en.nav.links[section]}</a>
      ))}
      <div class="flex items-center gap-1.5 pl-1">
        <a
          href="/CV-Agilahmadmaulana.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center justify-center rounded-full border border-green/40 bg-transparent px-4 py-2 text-xs font-semibold tracking-wider text-green transition-[color,border-color,background-color,box-shadow,transform] duration-200 ease-out hover:border-green hover:bg-green/10 hover:shadow-[0_0_16px_rgba(57,255,20,0.3)] active:scale-95"
        ><span data-i18n="nav.resume">{resumeLabel}</span></a>
        <button type="button" data-theme-toggle class={themeToggleClass} aria-label={translations.en.nav.switchToLight} aria-pressed="false">
          <svg data-icon="moon" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
          <svg data-icon="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
        <button type="button" data-language-toggle class={langToggleClass} aria-label={translations.en.nav.switchToIndonesian}>
          <svg class="size-4 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
            <path d="M2 12h20" />
          </svg>
          <span data-lang-label>ID</span>
        </button>
      </div>
    </div>

    <div class="flex items-center gap-1.5 md:hidden">
      <button type="button" data-theme-toggle class={themeToggleClass} aria-label={translations.en.nav.switchToLight} aria-pressed="false">
        <svg data-icon="moon" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
        <svg data-icon="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      <button type="button" data-language-toggle class={langToggleClass} aria-label={translations.en.nav.switchToIndonesian}>
        <svg class="size-4 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
          <path d="M2 12h20" />
        </svg>
        <span data-lang-label>ID</span>
      </button>
      <button
        type="button"
        data-menu-toggle
        class="hamburger"
        aria-label={translations.en.nav.openMenu}
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="hamburger-bar" aria-hidden="true"></span>
        <span class="hamburger-bar" aria-hidden="true"></span>
        <span class="hamburger-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="mobile-drawer" data-mobile-drawer class="mobile-drawer">
    <div class="mobile-drawer-inner">
      {NAV_LINKS.map((section) => (
        <a href={`#${section}`} data-scroll-target={section} data-i18n={`nav.links.${section}`}>
          {translations.en.nav.links[section]}
        </a>
      ))}
      <a
        href="/CV-Agilahmadmaulana.pdf"
        target="_blank"
        rel="noopener noreferrer"
        data-drawer-close
        class="drawer-cta"
      ><span data-i18n="nav.resume">{resumeLabel}</span></a>
    </div>
  </div>
</nav>
